{
  "name": "@shrinivas-sn/verify-claims",
  "version": "0.1.0",
  "description": "Attach the proof to a doc claim, then check it hasn't gone false.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shrinivas-sn/verify-claims.git"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "verify-claims": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "lint": "eslint .",
    "packcheck": "npm run build && publint && attw --pack . --profile esm-only",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "publint": "^0.3.23",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "tinyglobby": "^0.2.17"
  }
}
